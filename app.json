{
  "expo": {
    "name": "CozinhaFast Pro",
    "slug": "cozinhafast-pro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-bip.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-cozinhafast.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4713"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.contabilbr.cozinhafastpro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app uses your photo library to let you upload images.",
        "NSCameraUsageDescription": "This app uses your camera to let you take photos to upload.",
        "NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to connect to thermal printers for printing receipts and orders.",
        "NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth to connect to thermal printers for printing receipts and orders."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "br.com.contabilbr.cozinhafastpro.Livre",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "READ_MEDIA_IMAGES",
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "targetSdkVersion": 35,
            "buildArchs": ["arm64-v8a", "armeabi-v7a"],
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "scheme": "cozinhafastpro",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://prod-proj-vybakydnnjqvqgpvqsu2h-liwg5h36mq-ey.a.run.app"
    }
  }
}
